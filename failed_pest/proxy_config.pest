// Pest grammar file: proxy_config.pest
// Define this grammar in a file called proxy_config.pest

// Grammar rules
document      = { SOI ~ proxy_section* ~ EOI }
proxy_section = { proxy_header ~ (domain_section | route_section)* }
proxy_header = { "listener" ~ "=" ~ string ~ (key_value_line)* }
domain_section = { "[[" ~ string ~ "]]" ~ domain_body }
domain_body = { (key_value_line)* ~ (route_section)* }
route_section = { "[[[" ~ string ~ "]]]" ~ route_body }
route_body = { (key_value_line)* }

key_value_line = { key ~ "=" ~ value }
key = @{ ASCII_ALPHANUMERIC+ }
value = @{ string | number | boolean }
string = { "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
number = @{ ASCII_DIGIT+ }
boolean = { "true" | "false" }
WHITESPACE = _{ " " | "\t" | "\n" | "\r" }

